            "description": {
              "content": "Login History events can be filtered by specifying a date interval.<br> Maximum number of events that will be received by page is 200. <br> The OAuth 2.0 scope to use is <tt>team.login-history:read</tt>.<br> If there would be more events on the specified date interval total number of pages will be returned for further querying.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "external",
                "authentication-events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "pageNumber",
                  "value": "0",
                  "description": "Page number to be retrieved, starts with 0"
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "200",
                  "description": "Limit of results per page"
                },
                {
                  "disabled": false,
                  "key": "from",
